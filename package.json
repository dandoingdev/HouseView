{
  "name": "houseview",
  "version": "1.7.0",
  "type": "module",
  "description": "An opinionated Home Assistant dashboard that makes everyday home controls easy for everyone else.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "node tools/gen-widgets.mjs",
    "gen:check": "node tools/gen-widgets.mjs --check",
    "gen-docs": "node tools/gen-docs.mjs",
    "gen-docs:check": "node tools/gen-docs.mjs --check",
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --dev",
    "build:min": "node tools/build.mjs --out-dir=dist-min",
    "dev": "node tools/dev.mjs",
    "check:widgets": "node tools/check-widgets.mjs",
    "check:overviews": "node tools/check-overviews.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tools/test-all.mjs",
    "test:release": "node tools/test-all.mjs --release",
    "test:serial": "npm run test:unit && npm run build:dev && npm run test:browser && npm run test:browser:min && npm run test:widgets && npm run test:overviews && npm run test:overviews:input && npm run test:overviews:timer && npm run test:overviews:automatic && npm run test:overviews:light && npm run test:media:library && npm run test:panel && npm run test:overviews:clock && npm run test:overviews:volume && npm run test:media:seek && npm run test:touch-targets && npm run test:dashboard:swipe",
    "test:unit": "node --test \"tests/unit/*.test.mjs\" \"tests/contract/*.test.mjs\" \"tests/overviews/*.test.mjs\"",
    "test:browser": "node tools/run-tests.mjs tests/browser.html --target=dist",
    "test:browser:min": "npm run build:min && node tools/run-tests.mjs tests/browser.html --target=dist-min",
    "test:widgets": "node tools/run-tests.mjs tests/widgets/index.html --target=dist",
    "test:overviews": "node tools/run-tests.mjs tests/overviews/index.html --target=dist",
    "test:overviews:input": "node tests/overviews/screensaver-input.mjs",
    "test:overviews:timer": "node tests/overviews/timer-input.mjs",
    "test:overviews:automatic": "node tests/overviews/automatic-input.mjs",
    "overview-shots": "node tools/overview-shots.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "new:widget": "node tools/new-widget.mjs",
    "new:overview": "node tools/new-widget.mjs --family overview",
    "perf": "node tools/perf-bench.mjs",
    "size": "node tools/size-check.mjs",
    "release": "node tools/release.mjs",
    "deploy": "node tools/deploy.mjs",
    "bump-cache": "node tools/bump-cache.mjs",
    "test:overviews:light": "node tests/overviews/light-input.mjs",
    "test:media:seek": "node tests/media-seek-input.mjs",
    "test:media:library": "node tools/run-tests.mjs tests/media-library.html --target=dist && node tests/media-library-input.mjs",
    "test:panel": "node tests/panel-input.mjs",
    "test:overviews:clock": "node tests/overviews/clock-input.mjs",
    "test:overviews:volume": "node tests/overviews/volume-input.mjs",
    "test:touch-targets": "node tests/touch-targets.mjs",
    "test:dashboard:swipe": "node tests/dashboard-swipe-input.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.14.0"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "dashboard",
    "custom-card",
    "hacs",
    "wall-tablet",
    "nspanel",
    "screensaver"
  ],
  "homepage": "https://github.com/dandoingdev/HouseView#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dandoingdev/HouseView.git"
  },
  "bugs": {
    "url": "https://github.com/dandoingdev/HouseView/issues"
  },
  "author": "dandoingdev (https://github.com/dandoingdev)"
}
